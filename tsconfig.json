{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": [
            "ES2022"
        ],
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "types": [
            "node"
        ],
        "rootDir": "./src",
        "outDir":"./dist"
    },  
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}